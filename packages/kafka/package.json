{
  "name": "@libresuite/kafka",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p . && tsc-alias",
    "build:watch": "concurrently \"tsc --watch --preserveWatchOutput -p .\" \"tsc-alias --watch\"",
    "dev": "pnpm --filter @libresuite/kafka build:watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@libresuite/tsconfig": "workspace:*",
    "@types/node": "^25.3.5",
    "concurrently": "^9.2.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
