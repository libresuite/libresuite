{
  "name": "libresuite",
  "displayName": "LibreSuite",
  "version": "0.0.0",
  "private": true,
  "description": "The unified collaboration suite you’ve always wanted — open, flexible, limitless.",
  "repository": {
    "type": "git",
    "url": "https://github.com/libresuite/libresuite.git"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check --write --unsafe",
    "clean": "rimraf {.,./apps/*,./packages/*,./services/*}/{dist,.next,.turbo,tsconfig.tsbuildinfo}",
    "clean:all": "rimraf {.,./apps/*,./packages/*,./services/*}/{dist,.next,.turbo,node_modules}",
    "dev": "turbo run dev --parallel",
    "format": "biome format --write",
    "postinstall": "pnpm sort",
    "lint": "biome lint --write",
    "sort": "sort-package-json {.,apps/*,packages/*,services/*}/package.json",
    "start": "turbo run start --parallel",
    "typecheck": "turbo run typecheck --parallel"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "rimraf": "^6.1.3",
    "sort-package-json": "^3.6.1",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  }
}
