{
  "name": "@libresuite/users",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc -p . && tsc-alias",
    "build:watch": "concurrently \"tsc --watch --preserveWatchOutput -p .\" \"tsc-alias --watch\"",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "dotenv --env .env.development -- prisma migrate dev",
    "dev": "concurrently \"pnpm start:watch\" \"pnpm build:watch\"",
    "start": "node dist/server.js",
    "start:watch": "node --watch dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libresuite/constants": "workspace:*",
    "@libresuite/env": "workspace:*",
    "@libresuite/kafka": "workspace:*",
    "@libresuite/logger": "workspace:*",
    "@libresuite/middlewares": "workspace:*",
    "@libresuite/utils": "workspace:*",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@libresuite/tsconfig": "workspace:*",
    "@libresuite/types": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.18.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.4.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
